{
  "assistant": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Rosé Pine Moon",
    "dark": "Rosé Pine Moon"
  },
  "ui_font_family": "Menlo"
}
