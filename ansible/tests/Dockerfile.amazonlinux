FROM amazonlinux:latest

# Install required packages: sudo, ansible, and dependencies
RUN dnf update -y && \
    dnf install -y \
        sudo \
        python3 \
        python3-pip \
        git \
        tar \
        gzip \
        which && \
    pip3 install --no-cache-dir ansible

# Create the user
RUN useradd -m -s /bin/bash myuser && \
    echo 'myuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Set home explicitly
ENV HOME=/home/myuser

# Copy files and fix ownership
COPY . $HOME/.config
COPY ansible $HOME/ansible
RUN chown -R myuser:myuser $HOME/.config $HOME/ansible

# Switch to the new user
USER myuser
WORKDIR $HOME/ansible

# Default command
CMD ["/bin/bash"]
